# 실제 값은 .env 파일에 넣고 커밋하지 않는다 (.gitignore에 이미 포함됨)

# Postgres 연결 문자열. 없으면 data/subscribers.json 파일로 자동 폴백된다.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Web Push VAPID 키 쌍. 배포 환경(Render 등)은 재시작 시 파일시스템이 초기화될 수 있어
# 로컬 data/vapid.json에만 의존하면 배포될 때마다 키가 바뀌어 기존 구독이 전부 무효화된다.
# 로컬에서 이미 생성된 data/vapid.json의 publicKey/privateKey 값을 그대로 옮겨 고정한다.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...

# /api/send-daily 크론 엔드포인트 보호용 시크릿. 설정하지 않으면 인증 없이 열려있다(로컬 개발용).
# CRON_SECRET=change-me-before-deploying

# 문제 제안(Phase 7) → GitHub PR 자동 생성에 필요. contents:write, pull-requests:write 권한을
# 이 저장소로만 제한한 Fine-grained PAT를 발급해서 넣는다. 없으면 /suggest.html 폼이 비활성화된다.
# GITHUB_TOKEN=github_pat_xxx
# GITHUB_REPO=NostalgicJ/2026-SummerAICamp
# GITHUB_BASE_BRANCH=main
